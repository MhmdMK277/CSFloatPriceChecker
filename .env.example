# CSFloat Tracker - optional environment overrides.
# The app works with zero configuration; these exist for Docker and unusual setups.

# Where runtime state lives (SQLite DB, refreshed item catalog, file-fallback secrets).
# Default: platform app-data dir (e.g. %APPDATA%/csfloat-tracker on Windows).
#CSFLOAT_TRACKER_DATA=/data

# Where the built frontend lives (only needed for custom deployments).
#CSFLOAT_TRACKER_STATIC=/app/static

# NOTE: the CSFloat API key is NOT configured here. Set it in the web UI
# (Settings) or with `csfloat-tracker key set` - it is stored in the OS
# keychain, or an owner-only file when no keychain exists.
